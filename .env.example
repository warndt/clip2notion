# Copy to .env for local development. Never commit .env.
# In production these are set in the Netlify UI, not in any file.

# Notion internal integration token. The integration must be shared with the
# WDB | Resources database. SECRET.
NOTION_TOKEN=

# Shared secret the caller sends in the X-Clip-Secret header. SECRET.
CLIP_SHARED_SECRET=

# Data source id for WDB | Resources. Optional — this is the default.
RESOURCES_DATA_SOURCE_ID=<your-data-source-id>

# Notion API version header. Optional. Re-check the live docs before changing.
NOTION_API_VERSION=2026-03-11
