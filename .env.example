# Copy to .env for local development. Never commit .env.
# In production these are set in the Netlify UI, not in any file.

# Notion internal integration token, from notion.so/my-integrations.
# The integration must be shared with your target database. SECRET.
NOTION_TOKEN=

# Shared secret the caller sends in the X-Clip-Secret header, and the token in
# the MCP connector URL. Generate one: openssl rand -hex 32. SECRET.
CLIP_SHARED_SECRET=

# REQUIRED. The *data source* id of the database this service may write to.
# Not the database id — current Notion API versions distinguish the two.
# Every clip target is checked against this, so a leaked secret still cannot
# append to arbitrary pages in your workspace. See README, "Point it at your
# own database", for how to find it.
RESOURCES_DATA_SOURCE_ID=

# Notion API version header. Optional. Re-check the live docs before changing.
NOTION_API_VERSION=2026-03-11

# Lead image — the hero that sits outside the article body. Optional.
#   off     skip selection entirely
#   detect  select and log what it would insert, write nothing
#   insert  place it below the Source: line (default)
# Set this to detect or off to roll back. A Netlify env change needs a redeploy
# before live functions see it.
LEAD_IMAGE_MODE=insert
